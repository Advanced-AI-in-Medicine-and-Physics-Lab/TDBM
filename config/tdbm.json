{
    "experiment_name": "TDBM",

    "synthetic_data_root": "data/synthetic/train",
    "real_data_root": "data/real/train",
    "val_image_root": "data/XCA30/Images",
    "val_gt_root": "data/XCA30/GT",
    "val_frames": [2],
    "val_crop_size": 280,
    "val_num_crops": 3,
    "val_resize_to": 448,

    "imgSize": 256,
    "neighbor_num": 3,
    "inner_channel": 64,
    "res_blocks": 2,
    "attn_res": [16],
